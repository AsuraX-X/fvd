// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN  @map("admin")
  EXPERT @map("expert")
  USER   @map("user")
}

enum ApplicationStatus {
  PENDING  @map("pending")
  APPROVED @map("approved")
  REJECTED @map("rejected")
}

// LISTED is the only publicly visible state. UNLISTED_BY_ADMIN can only be
// cleared by an admin — setOwnListing (app/dashboard/profile/actions.ts)
// refuses to touch it, and setExpertListing (app/admin/experts/actions.ts)
// won't relist an expert who unlisted themselves.
enum ListingStatus {
  LISTED             @map("listed")
  UNLISTED_BY_EXPERT @map("unlisted_by_expert")
  UNLISTED_BY_ADMIN  @map("unlisted_by_admin")
}

enum EnquiryStatus {
  NEW      @map("new")
  READ     @map("read")
  ARCHIVED @map("archived")
}

model User {
  id            String        @id
  name          String
  email         String
  emailVerified Boolean       @default(false)
  image         String?
  // Version of the Terms/Privacy Policy the user last accepted (see lib/terms.ts).
  termsVersion    String?
  termsAcceptedAt DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  sessions      Session[]
  accounts      Account[]
  profile       Profile?
  savedExperts  SavedExpert[]
  application   Application?
  enquiries     Enquiry[]
  reviews       Review[]

  @@unique([email])
  @@map("user")
}

model Profile {
  id            String        @id
  avatar        String?
  email         String        @unique
  firstName     String
  surname       String
  location      String?
  headline      String?
  website       String?
  bio           String?
  specialty     String?
  rate          Int?
  role          Role          @default(USER)
  listingStatus ListingStatus @default(LISTED)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  userId           String            @unique
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  links            ProfileLink[]
  selectedProjects SelectedProject[]
  savedBy          SavedExpert[]     @relation("SavedExpertProfile")
  reviewsReceived  Review[]          @relation("ExpertReviews")

  conversationsAsParticipantOne Conversation[] @relation("ConversationParticipantOne")
  conversationsAsParticipantTwo Conversation[] @relation("ConversationParticipantTwo")
  sentMessages                  Message[]      @relation("MessageSender")

  @@index([role, listingStatus])
  @@map("profile")
}

// Role pairing (USER<->EXPERT, or ADMIN<->anyone) is enforced in
// getOrCreateConversation (app/messages/actions.ts), not the DB.
// participantOneId/participantTwoId are role-agnostic and canonically
// ordered (smaller Profile.id first) so the unique pair is order-independent.
model Conversation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participantOneId String
  participantOne   Profile @relation("ConversationParticipantOne", fields: [participantOneId], references: [id], onDelete: Cascade)

  participantTwoId String
  participantTwo   Profile @relation("ConversationParticipantTwo", fields: [participantTwoId], references: [id], onDelete: Cascade)

  messages Message[]

  @@unique([participantOneId, participantTwoId])
  @@index([participantTwoId])
  @@map("conversation")
}

model Message {
  id        String    @id @default(cuid())
  content   String
  createdAt DateTime  @default(now())
  readAt    DateTime?

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  senderId String
  sender   Profile @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  attachments MessageAttachment[]

  @@index([conversationId, createdAt])
  @@index([conversationId, readAt])
  @@map("message")
}

model MessageAttachment {
  id        String   @id @default(cuid())
  url       String
  fileName  String
  size      Int
  order     Int      @default(0)
  createdAt DateTime @default(now())

  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@map("message_attachment")
}

model SavedExpert {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expertId String
  expert   Profile @relation("SavedExpertProfile", fields: [expertId], references: [id], onDelete: Cascade)

  @@unique([userId, expertId])
  @@index([expertId])
  @@map("saved_expert")
}

// One review per (user, expert) pair — resubmitting updates the existing row.
// userId is nullable + SetNull so a review outlives its author's account
// deletion (shown as "Former member"); it still cascades with the expert.
// DB-level CHECK constraints (added by hand in the add_review migration, since
// Prisma can't express them): rating BETWEEN 1 AND 5, non-blank comment of at
// most 2000 chars, and userId <> expertId (Profile.id === User.id, so this
// blocks self-reviews). "expertId must be an EXPERT profile" is role-based and
// enforced in submitReview (app/experts/actions.ts), not the DB.
model Review {
  id        String   @id @default(cuid())
  rating    Int
  comment   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  expertId String
  expert   Profile @relation("ExpertReviews", fields: [expertId], references: [id], onDelete: Cascade)

  @@unique([userId, expertId])
  @@index([expertId, createdAt])
  @@map("review")
}

model ProfileLink {
  id        String   @id @default(cuid())
  label     String
  url       String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("profile_link")
}

model SelectedProject {
  id        String   @id @default(cuid())
  imageUrl  String
  title     String
  url       String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("selected_project")
}

model Application {
  id           String            @id @default(cuid())
  name         String
  email        String
  specialty    String
  bio          String
  portfolioUrl String?
  status       ApplicationStatus @default(PENDING)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  links ApplicationLink[]

  @@index([status])
  @@map("application")
}

model ApplicationLink {
  id        String   @id @default(cuid())
  label     String
  url       String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@map("application_link")
}

model Enquiry {
  id        String        @id @default(cuid())
  name      String
  email     String
  brief     String
  status    EnquiryStatus @default(NEW)
  createdAt DateTime      @default(now())

  // Nullable + SetNull so admins keep the enquiry after the sender deletes
  // their account (name/email/brief are stored on the row itself).
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@map("enquiry")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
